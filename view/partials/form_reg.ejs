<h1>Регистрация</h1>
<p class="sub">Заполните данные для создания аккаунта</p>

<form class="form-box" method="POST" action="/auth/signup" novalidate>
    <div class="field <%= errors && errors.username ? 'error' : '' %>">
        <label for="username">Имя пользователя</label>
        <input type="text" id="username" name="username" value="<%= values && values.username ? values.username : '' %>"
            required>
        <% if (errors && errors.username) { %>
            <p class="error-text">
                <%= errors.username[0] %>
            </p>
            <% } %>
    </div>

    <div class="field <%= errors && errors.email ? 'error' : '' %>">
        <label for="email">Почта</label>
        <input type="email" id="email" name="email" value="<%= values && values.email ? values.email : '' %>" required>
        <% if (errors && errors.email) { %>
            <p class="error-text">
                <%= errors.email[0] %>
            </p>
            <% } %>
    </div>

    <div class="field <%= errors && errors.password ? 'error' : '' %>">
        <label for="password">Пароль</label>
        <input type="password" id="password" name="password" required>
        <% if (errors && errors.password) { %>
            <p class="error-text">
                <%= errors.password[0] %>
            </p>
            <% } %>
    </div>

    <% for(var i=0; i < roles.length; i++) { %>
        <input type="hidden" name="roles" value="<%= roles[i] %>" />
        <% } %>

            <button type="submit" class="btn">Зарегистрироваться</button>
</form>