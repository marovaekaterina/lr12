<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
    @import url('https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;700&display=swap');

    :root {
        --bg: #f3f5f9;
        --text: #1c2230;
        --card: #ffffff;
        --border: #dfe3ea;
        --muted: #6b7385;
        --accent: #4f6bed;
        --danger: #e5484d;
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: 'Golos Text', sans-serif;
        background: var(--bg);
        color: var(--text);
    }

    .page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card {
        width: 100%;
        min-height: 100vh;
        padding: 32px 20px;
        background: var(--card);
        border: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    h1 {
        margin: 0;
        font-size: 24px;
    }

    .sub {
        margin: 0 0 8px;
        color: var(--muted);
        font-size: 14px;
    }

    .form-box {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 14px;
    }

    .field input {
        width: 100%;
        padding: 11px 12px;
        font: inherit;
        color: var(--text);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 8px;
    }

    .field input:focus {
        outline: 2px solid var(--accent);
    }

    .field.error input {
        border-color: var(--danger);
    }

    .error-text {
        color: var(--danger);
        margin: 0;
        font-size: 13px;
    }

    .forgot {
        color: var(--accent);
        font-size: 14px;
        text-decoration: none;
    }

    .forgot:hover {
        text-decoration: underline;
    }

    .btn {
        display: inline-block;
        width: 100%;
        padding: 12px;
        font: inherit;
        font-weight: 500;
        color: #fff;
        background: var(--accent);
        border: 0;
        border-radius: 8px;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
    }

    .data-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin: 4px 0 8px;
    }

    .data-item {
        padding: 10px 12px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 14px;
    }

    .data-label {
        color: var(--muted);
        font-size: 12px;
        margin-bottom: 4px;
    }

    .data-value {
        font-weight: 500;
        word-break: break-all;
    }

    @media (min-width: 768px) {
        .card {
            max-width: 400px;
            min-height: 0;
            border-radius: 14px;
            padding: 36px;
        }
    }
</style>